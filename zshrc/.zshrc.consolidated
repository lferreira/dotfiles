# =============================================================================
# Consolidated .zshrc Configuration (MINIMAL, SAFE, COMMENTED)
# =============================================================================

# --- Oh My Zsh setup (unique to zsh) ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git kubectl kube-ps1)

source ~/.oh-my-zsh/oh-my-zsh.sh

PROMPT='$(kube_ps1)'$PROMPT

# --- Source all your environment, aliases, and extras via bash_profile ---
# This will set GOPATH, PATH, aliases, etc.
source ~/.bash_profile

# --- Any zsh-specific customizations can go below this line ---

# Clean PATH configuration - prioritize Homebrew and user tools
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/bin:$HOME/.volta/bin:$HOME/.rvm/bin:$HOME/go/work/bin"

# =============================================================================
# Additional PATH additions
# =============================================================================

export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

